# Kakao REST (optional; Nominatim / OSRM fallback without it)
# Same key powers Local geocoding + Navi 자동차 길찾기 (월 ~1만 건 Directions).
# Server-only via Vite proxy (/api/kakao/*) — never expose in client bundle.
KAKAO_REST_API_KEY=

# Naver Cloud Platform Maps (optional; used for Directions 5 자동차 길찾기)
# Server-only via Vite proxy (/api/naver/direction) — never expose in client bundle.
# Console: NAVER Cloud → AI·NAVER API → Maps → Application
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Korea Expressway OpenAPI (data.ex.co.kr) — optional
# Demo key `test` works for some endpoints (e.g. realtime traffic / route names).
# Request a personal key at https://data.ex.co.kr/openapi/apikey/requestKey
# Never commit real keys. Server-only via Vite proxy (/api/ex/*).
EX_API_KEY=

# Legacy / unused by primary path
# JUSO_CONFM_KEY=
